# Server-side only. Copy to `.env` for local development (never commit it) or set these as
# service variables on Railway. Nothing in this file is shipped to the browser.

# --- SMTP (required: the API refuses to send until all four are set) ---
# The EMAIL_* names are accepted as aliases: EMAIL_HOST, EMAIL_PORT, EMAIL_USER, EMAIL_PASS,
# EMAIL_SECURE, EMAIL_FROM, EMAIL_FROM_NAME, EMAIL_TO, EMAIL_TIMEZONE.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional. Defaults: SMTP_SECURE=true when SMTP_PORT is 465 (implicit TLS), false otherwise
# (STARTTLS is used when the server offers it). SMTP_REQUIRE_TLS=true refuses unencrypted sends.
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true

# --- Notification addressing (defaults shown) ---
MAIL_FROM=no-reply@tissuebioengineering.com
MAIL_FROM_NAME=Tissue Bioengineering
MAIL_TO=info@tissuebioengineering.com
# IANA time zone for the human-readable submission time in notifications.
# MAIL_TIMEZONE=Asia/Dubai

# --- HTTP server ---
# Railway injects PORT. Local default is 8787 (the Vite dev server proxies /api to it).
# PORT=8787
# Proxy hops in front of the app, for correct visitor IPs in rate limiting (Railway: 1).
# TRUST_PROXY=1
# Form submissions allowed per IP per window.
# FORM_RATE_LIMIT_MAX=5
# FORM_RATE_LIMIT_WINDOW_MS=900000
# Built site directory served with SPA fallback. Set SERVE_STATIC=false for an API-only process.
# STATIC_DIR=dist
# SERVE_STATIC=true
# Only when the site is hosted on a different origin than this API (then also set
# VITE_API_BASE_URL at build time for the frontend).
# CORS_ORIGIN=https://www.tissuebioengineering.com
